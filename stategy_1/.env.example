# OANDA API Credentials
OANDA_API_KEY=your_oanda_v20_personal_access_token_here
OANDA_ACCOUNT_ID=101-001-40911775-001
OANDA_ENV=practice

# Capital & Prop Firm Challenge Rules
VIRTUAL_CAPITAL=2000.0
TARGET_PROFIT_PCT=8.0
MAX_DRAWDOWN_PCT=8.0
MAX_DAILY_LOSS_PCT=5.0
DAILY_CIRCUIT_BREAKER_PCT=3.5
MAX_DAILY_LOSSES=2

# Risk Management
RISK_PER_TRADE_PCT=1.25
RISK_REWARD_RATIO=2.0
MAX_CONCURRENT_TRADES=1
MAX_TRADES_PER_DAY=3
MAX_SPREAD_PIPS=2.5

# Strategy & Pairs
INSTRUMENTS=GBP_USD,EUR_USD
TIMEFRAME=M15

# Session Timing (UTC)
SESSION_FILTER_ENABLED=true
SESSION_START_HOUR_UTC=7
SESSION_END_HOUR_UTC=17

# Server & Security
PORT=5000
HOST=0.0.0.0
POLL_INTERVAL_SECONDS=10
SECRET_KEY=generate_a_random_secret_key
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=choose_a_strong_password

