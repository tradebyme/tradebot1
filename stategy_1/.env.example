# =====================================================================
# OANDA MULTI-BOT PROP FIRM GATEWAY CONFIGURATION (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# BOT 1: STRATEGY 1 (OLD BOT - M15 MOMENTUM SCALPER)
# ---------------------------------------------------------------------
OANDA_API_KEY=your_oanda_v20_api_key_here
OANDA_ACCOUNT_ID=101-001-XXXXXXX-001
OANDA_ENV=practice

# Capital & Prop Challenge Sizing ($2,000 Initial Baseline)
CHALLENGE_START_DATE=2026-11-24T15:00:00Z
VIRTUAL_CAPITAL=2000.0
TARGET_PROFIT_PCT=8.0
MAX_DRAWDOWN_PCT=8.0
MAX_DAILY_LOSS_PCT=5.0
DAILY_CIRCUIT_BREAKER_PCT=3.0
MAX_DAILY_LOSSES=2

# Risk & Execution Parameters (Optimized for Prop Firm Survival)
RISK_PER_TRADE_PCT=0.75
RISK_REWARD_RATIO=1.2
MAX_CONCURRENT_TRADES=1
MAX_TRADES_PER_DAY=3
MAX_SPREAD_PIPS=6.0

# Strategy & Session (London 07:00 UTC to NY 17:00 UTC)
INSTRUMENTS=GBP_USD,EUR_USD
TIMEFRAME=M15
SESSION_FILTER_ENABLED=true
SESSION_START_HOUR_UTC=7
SESSION_END_HOUR_UTC=17

# ---------------------------------------------------------------------
# BOT 2: APEX SNIPER (NEW ISOLATED BOT - H4/H1 INSTITUTIONAL TREND-ATR)
# ---------------------------------------------------------------------
OANDA_API_KEY_APEX=your_apex_oanda_v20_api_key_here
OANDA_ACCOUNT_ID_APEX=101-001-XXXXXXX-002

# APEX Capital & Prop Challenge Rules ($2,000 Initial Baseline)
APEX_VIRTUAL_CAPITAL=2000.0
APEX_TARGET_PROFIT_PCT=8.0
APEX_TARGET_PROFIT_P2_PCT=5.0
APEX_MAX_DRAWDOWN_PCT=8.0
APEX_MAX_DAILY_LOSS_PCT=5.0
APEX_DAILY_CIRCUIT_BREAKER_PCT=3.0
APEX_MAX_DAILY_LOSSES=2

# APEX Risk & Execution Parameters
APEX_RISK_PER_TRADE_PCT=0.75
APEX_MAX_CONCURRENT_TRADES=2
APEX_MAX_TRADES_PER_DAY=3
APEX_MAX_SPREAD_PIPS=4.0

# APEX Portfolio Basket & Multi-Timeframes
APEX_INSTRUMENTS=XAU_USD,EUR_USD,GBP_USD
TF_XAUUSD=H4
TF_EURUSD=H4
TF_GBPUSD=H1

# APEX Technical Indicators (5-Year MT5 Verified Parameters)
FAST_EMA=20
SLOW_EMA=50
TREND_EMA=200
ATR_PERIOD=14
ATR_SL_MULTIPLIER=2.0
ATR_TRAIL_MULTIPLIER=3.0
MAX_DIST_ATR_MULTIPLIER=2.0
TRAIL_ACTIVATION_ATR=1.0

# ---------------------------------------------------------------------
# WEB SERVER & GATEWAY SECURITY
# ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
POLL_INTERVAL_SECONDS=10
SECRET_KEY=generate-a-random-secret-key-here
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_secure_password_here
