# ========================================================
# OANDA Multi-Bot Prop Firm Cloud Gateway Configuration
# ========================================================

# Default Shared Credentials (used if bot-specific credentials are omitted)
OANDA_API_KEY=your_oanda_v20_api_key_here
OANDA_ACCOUNT_ID=101-001-XXXXXXX-001
OANDA_ENV=practice

# --------------------------------------------------------
# ISOLATED CREDENTIALS (Optional: Use separate accounts/keys)
# --------------------------------------------------------
# Bot 1: Strategy 1 (M15 Scalper)
OANDA_API_KEY_1=your_oanda_v20_api_key_here
OANDA_ACCOUNT_ID_1=101-001-XXXXXXX-001

# Bot 2: APEX SNIPER / Strategy 5 (H4/H1 Institutional)
OANDA_API_KEY_APEX=your_oanda_v20_api_key_here
OANDA_ACCOUNT_ID_APEX=101-001-XXXXXXX-002

# --------------------------------------------------------
# Prop Challenge Settings
# --------------------------------------------------------
VIRTUAL_CAPITAL=2000.0
TARGET_PROFIT_PCT=8.0
MAX_DRAWDOWN_PCT=8.0
MAX_DAILY_LOSS_PCT=5.0

# Security (Optional Web Dashboard Login)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_secure_password_here
PORT=5000
