MA_MAX=50
VOL_LENGTH=9
SMOOTH_LENGTH=3
ER_LENGTH=10
FAST_BIAS=0.30
NOISE_LENGTH=20
NOISE_MULT=0.60

# Session Hours (UTC: London 07:00 to NY 17:00)
