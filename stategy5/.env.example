# OANDA API Credentials
OANDA_API_KEY=your_oanda_v20_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENV=practice

# Prop Challenge & Capital Rules
CHALLENGE_START_DATE=2026-11-15
VIRTUAL_CAPITAL=2000.0
TARGET_PROFIT_PCT=8.0
MAX_DRAWDOWN_PCT=8.0
MAX_DAILY_LOSS_PCT=5.0
DAILY_CIRCUIT_BREAKER_PCT=3.0
MAX_DAILY_LOSSES=2

# Risk Settings
RISK_PER_TRADE_PCT=0.75
MAX_CONCURRENT_TRADES=2
MAX_TRADES_PER_DAY=3
MAX_SPREAD_PIPS=4.0

# Portfolio & Timeframes
INSTRUMENTS=XAU_USD,EUR_USD,GBP_USD
TF_XAUUSD=H4
TF_EURUSD=H4
TF_GBPUSD=H1

# Indicators
FAST_EMA=20
SLOW_EMA=50
TREND_EMA=200
ATR_PERIOD=14
ATR_SL_MULTIPLIER=2.0
ATR_TRAIL_MULTIPLIER=3.0
MAX_DIST_ATR_MULTIPLIER=2.0
TRAIL_ACTIVATION_ATR=1.0

# Web Dashboard
PORT=5005
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_secure_password_here
