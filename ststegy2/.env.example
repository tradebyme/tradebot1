# OANDA API Credentials
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENV=practice

# Prop Challenge Rules ($2,000 Base)
VIRTUAL_CAPITAL=2000.0
TARGET_PROFIT_PCT=8.0
MAX_DRAWDOWN_PCT=8.0
MAX_DAILY_LOSS_PCT=5.0
DAILY_CIRCUIT_BREAKER_PCT=3.5
MAX_DAILY_LOSSES=2

# Risk & R:R
RISK_PER_TRADE_PCT=1.25
RISK_REWARD_RATIO=2.0
MAX_CONCURRENT_TRADES=1
MAX_TRADES_PER_DAY=3
MAX_SPREAD_PIPS=6.0

# Strategy 2 Parameters (ALMA + SuperSmoother)
ALMA_LENGTH=34
ALMA_OFFSET=0.85
ALMA_SIGMA=6.0
DEV_LENGTH=34
DEV_MULT=0.65
SLOPE_LENGTH=3
SLOPE_MIN=0.08
ATR_LENGTH=14

STOP_LOOKBACK=12
MIN_STOP_ATR=0.75
MAX_STOP_ATR=2.5

# Instruments & Session (London/NY)
INSTRUMENTS=GBP_USD,EUR_USD
TIMEFRAME=M15
SESSION_FILTER_ENABLED=true
SESSION_START_HOUR_UTC=7
SESSION_END_HOUR_UTC=17

# Server
PORT=5001
HOST=0.0.0.0
POLL_INTERVAL_SECONDS=10
SECRET_KEY=strategy2-oanda-key-2026
DASHBOARD_USERNAME=admin
